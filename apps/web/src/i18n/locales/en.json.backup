  "about": {
    "title": "About CarboScan",
    "vision": {
      "title": "Our Vision",
      "content": "We believe that the transition to a low-carbon economy depends on companies' ability to understand and master their environmental footprint. In a context where regulations are intensifying and stakeholder expectations are evolving, organizations must equip themselves with reliable, simple and effective tools to measure, monitor and reduce their greenhouse gas emissions. CarboScan was founded to meet this need by offering a professional digital solution, designed to be both accessible and rigorous."
    },
    "mission": {
      "title": "Our Mission",
      "content": "Our mission is to support companies — from SMEs to large organizations — in managing their carbon impact. We provide solutions adapted to each stage of their approach: from initial assessment to action plan definition, through progress monitoring. CarboScan acts as a true strategic partner, enabling companies to integrate carbon management into their governance and daily practices."
    },
    "solutions": {
      "title": "Our Solutions",
      "intro": "CarboScan offers a structured offer in three complementary services:",
      "carboStart": "CarboStart — For SMEs and growing companies, wishing to structure their climate policy with a simple and effective tool.",
      "carboPro": "CarboPro — For large companies and multi-site groups seeking expert support, consolidated reporting and multi-user management.",
      "carboOmnibus": "CarboOmnibus — For networks, franchises and business federations requiring a consolidated view of their members' or subsidiaries' carbon assessments."
    },
    "commitments": {
      "title": "Our Commitments",
      "methodologyTitle": "Methodological rigor",
      "methodology": "All our analyses comply with recognized Carbon Footprint® standards.",
      "transparencyTitle": "Transparency and independence",
      "transparency": "We guarantee total confidentiality and absence of conflicts of interest.",
      "supportTitle": "Personalized support",
      "support": "Each client benefits from adapted follow-up and tailor-made advice.",
      "innovationTitle": "Continuous innovation",
      "innovation": "We invest in the development of high-performance, accessible and scalable digital tools."
    },
    "whyChoose": {
      "title": "Why choose CarboScan?",
      "content": "CarboScan is aimed at companies that want to go beyond declarative approaches to engage in real transformation. Our platform provides access to reliable analysis, high-performance monitoring tools and human support, to transform environmental constraints into sustainable competitiveness levers. By choosing CarboScan, you choose a pragmatic, results-oriented vision, at the service of your climate strategy."
    },
    "cta": "Contact us to learn more"
  },
  "contact": {
    "title": "Contact Us",
    "subtitle": "A question about our solutions, need a quote for a Carbon Assessment, or simply want to discuss your project? Our team is here to support you.",
    "email": "contact@carbotrack.io",
    "phone": "+216 55 053 505",
    "whatsapp": "WhatsApp: +216 98 704 385",
    "talkProject": {
