# API / DB
POSTGRES_USER=newcarboscan
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=newcarboscan
DATABASE_URL=postgresql://newcarboscan:change-me-strong-db-password@localhost:5435/newcarboscan

JWT_SECRET=change-me-long-random-jwt-secret
PORT=8080
# Prod VPS (derrière nginx same-origin) : mettre l'origine publique
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost
RATE_LIMIT_MAX=120
BODY_LIMIT_BYTES=1000000
IMPORT_ADMIN_TOKEN=change-me-import-token

# Export depuis CarboScan / Supabase (URI Postgres, pas l'URL HTTP)
# Dashboard Supabase → Settings → Database → Connection string → URI
SUPABASE_DB_URL=

# Web
# Dev : URL API locale. Prod Docker/nginx : laisser vide (same-origin /v1 /auth)
VITE_API_URL=http://localhost:8080
VITE_GA_MEASUREMENT_ID=

# Docker publish
HTTP_PORT=80
