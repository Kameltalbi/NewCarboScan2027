# API / DB
POSTGRES_USER=newcarboscan
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=newcarboscan
DATABASE_URL=postgresql://ncs_app:change-me-strong-db-password@localhost:5435/newcarboscan

JWT_SECRET=change-me-long-random-jwt-secret
PORT=8080
# Prod VPS (derrière nginx same-origin) : mettre l'origine publique
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost
RATE_LIMIT_MAX=120
BODY_LIMIT_BYTES=1000000
# Vide en prod sauf fenêtre d'import contrôlée (ALLOW_IMPORT_IN_PROD=true requis).
IMPORT_ADMIN_TOKEN=
ALLOW_IMPORT_IN_PROD=false
# Idle session (minutes) — cookie ncs_idle
IDLE_TIMEOUT_MINUTES=30
# Clé de chiffrement dumps (scripts/backup-postgres.sh) — ne jamais committer
# BACKUP_ENCRYPT_KEY=
# Copie hors-site du .dump.enc (répertoire local/NFS monté sur le VPS)
# BACKUP_OFFSITE_DIR=/mnt/offsite/ncs-backups

# Factor Resolver production calculation (default OFF — kill switch).
# When false: POST /v1/factors/resolve-and-calculate refuses calculation.
# Shadow POST /v1/factors/resolve remains available.
# Flag alone never bypasses DB calculation_status / resolver_status / safe subset.
# FE V1: after migration 024, Core/ADEME/UK versions may be calc+resolver enabled;
# only production safe subsets auto-resolve (ADEME ~2570, UK ~1260, Core TN 8).
FACTOR_RESOLVER_CALCULATION_ENABLED=false

# Export depuis CarboScan / Supabase (URI Postgres, pas l'URL HTTP)
# Dashboard Supabase → Settings → Database → Connection string → URI
SUPABASE_DB_URL=

# Web
# Dev : URL API locale. Prod Docker/nginx : laisser vide (same-origin /v1 /auth)
VITE_API_URL=http://localhost:8080
VITE_GA_MEASUREMENT_ID=

# Docker publish
HTTP_PORT=80
